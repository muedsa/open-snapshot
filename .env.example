HTTP_PORT=80
SNAPSHOT_CONFIG_FILE=./src/main/resources/application.yaml

# 留空表示沿用 application.yaml；填写后优先于挂载配置。
# 监听地址；改端口时需同步调整 Nginx upstream 的 snapshot:8080。
SNAPSHOT_SERVER_HOST=
SNAPSHOT_SERVER_PORT=
SNAPSHOT_MAX_REQUEST_SIZE=
SNAPSHOT_MAX_CONCURRENT_RENDERS=
SNAPSHOT_MAX_RENDER_TIMEOUT_MS=
SNAPSHOT_MAX_DOCUMENT_ELEMENTS=
SNAPSHOT_MAX_DOCUMENT_DEPTH=
# 渲染队列背压与渲染结果缓存。
SNAPSHOT_MAX_RENDER_QUEUE=
SNAPSHOT_RENDER_QUEUE_TIMEOUT_MS=
SNAPSHOT_RENDER_CACHE_ENABLED=
SNAPSHOT_RENDER_CACHE_MAX_ENTRIES=
SNAPSHOT_RENDER_CACHE_MAX_BYTES=
SNAPSHOT_RENDER_CACHE_TTL_MS=
# 耗时响应头（Server-Timing / X-Snapshot-Cache / X-Snapshot-Image-Count）。
SNAPSHOT_TIMING_HEADERS_ENABLED=
# 解析错误高亮图（?errorImage=png）。
SNAPSHOT_ERROR_IMAGE_ENABLED=
SNAPSHOT_ERROR_IMAGE_MAX_LINES=
SNAPSHOT_ERROR_IMAGE_MAX_COLUMNS=
SNAPSHOT_ERROR_IMAGE_CONTEXT_LINES=
# 可选：填写后 /snapshot 需要 API Key；不会转换为 JVM 命令行参数。
SNAPSHOT_API_KEY=
# 可选：多个 API Key，格式 名称:密钥,名称:密钥（同样不转换为命令行参数）。
SNAPSHOT_API_KEYS=
# /metrics 访问控制：open / credential / admin
SNAPSHOT_METRICS_ACCESS=
# 可观测性：结构化访问日志、Prometheus 指标、优雅停机时间。
SNAPSHOT_ACCESS_LOG_ENABLED=
SNAPSHOT_METRICS_ENABLED=
SNAPSHOT_SHUTDOWN_GRACE_MS=
SNAPSHOT_SHUTDOWN_TIMEOUT_MS=
# 列表配置：环境变量用英文逗号分隔（YAML 中仍可写成列表）。
SNAPSHOT_CORS_ALLOWED_HOSTS=
SNAPSHOT_FONT_FAMILY_NAMES=
SNAPSHOT_ACCESS_LOG_SKIP_PATHS=
# 分层限流：匿名按 IP、已认证按凭据、管理接口单独计桶。
SNAPSHOT_RATE_LIMIT_REQUESTS=
SNAPSHOT_RATE_LIMIT_WINDOW_MS=
SNAPSHOT_RATE_LIMIT_CREDENTIAL_REQUESTS=
SNAPSHOT_RATE_LIMIT_CREDENTIAL_WINDOW_MS=
SNAPSHOT_RATE_LIMIT_ADMIN_REQUESTS=
SNAPSHOT_RATE_LIMIT_ADMIN_WINDOW_MS=
SNAPSHOT_MAX_CANVAS_WIDTH=
SNAPSHOT_MAX_CANVAS_HEIGHT=
SNAPSHOT_MAX_CANVAS_PIXELS=
SNAPSHOT_TRUST_PROXY_HEADERS=true
SNAPSHOT_ADMIN_ENDPOINTS_ENABLED=
# 开启管理接口时必须设置强随机令牌。
SNAPSHOT_ADMIN_TOKEN=
SNAPSHOT_MAX_IMAGE_NUM=
SNAPSHOT_MAX_SINGLE_IMAGE_SIZE=
SNAPSHOT_MEMORY_CACHE_NUM_LIMIT=
SNAPSHOT_MAX_CACHE_BYTES=
SNAPSHOT_MAX_IMAGE_WIDTH=
SNAPSHOT_MAX_IMAGE_HEIGHT=
SNAPSHOT_MAX_IMAGE_PIXELS=
SNAPSHOT_MAX_TOTAL_IMAGE_PIXELS=
SNAPSHOT_ALLOW_PRIVATE_HOSTS=
SNAPSHOT_IMAGE_CONNECT_TIMEOUT_MS=
SNAPSHOT_IMAGE_READ_TIMEOUT_MS=
SNAPSHOT_IMAGE_CACHE_TTL_MS=
SNAPSHOT_IMAGE_MAX_RETRIES=
SNAPSHOT_IMAGE_RETRY_BACKOFF_MS=
